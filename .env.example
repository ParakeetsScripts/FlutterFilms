TMDB_API_TOKEN=
TMDB_API_KEY=
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database — Neon Postgres in production; SQLite fallback for local dev
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# DIRECT_DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=

# Secure cron endpoints (required in production)
CRON_SECRET=

# Catalog freshness threshold before on-demand TMDB refresh (ms)
SYNC_STALE_MS=21600000

# Import IMDb runtime from title.basics.tsv.gz (large download)
IMDB_IMPORT_BASICS=false

# Self-hosted AI (no per-message API credits — infrastructure costs still apply)
# Native Ollama API (recommended):
OLLAMA_BASE_URL=http://localhost:11434
# Remote example (must be reachable from this server — Vercel cannot use Tailscale-only IPs):
# OLLAMA_BASE_URL=http://100.98.79.102:11434
# OpenAI-compatible endpoint (Ollama /v1, vLLM, etc.):
# AI_LOCAL_ENDPOINT=http://100.98.79.102:11434/v1
AI_LOCAL_ENDPOINT=
AI_LOCAL_API_KEY=ollama

# Cloud fallback when no local model is connected (optional on Vercel)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Admin AI dashboard (falls back to CRON_SECRET in dev)
AI_ADMIN_SECRET=

# Authentication
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email provider optional — verification/reset links logged in dev when unset
RESEND_API_KEY=
